# =====================================================================
# BreatheWise Environment Variables Configuration
# Copy this file to .env or .env.local and populate with your credentials.
# =====================================================================

# ---------------------------------------------------------------------
# AI Services (Google Gemini) - Server-side only
# Get key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------
# Air Quality API (Google Maps Platform Air Quality API)
# Get key at: https://console.cloud.google.com/apis/library/airquality.googleapis.com
# ---------------------------------------------------------------------
GOOGLE_MAPS_AIR_QUALITY_API_KEY=

# ---------------------------------------------------------------------
# Supabase Configuration (Optional for Cloud Persistence)
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# ---------------------------------------------------------------------
# Deployment & Server Configuration
# NITRO_PRESET options: 'node-server' (Railway / Docker / Cloud Run), 'vercel' (Vercel)
# ---------------------------------------------------------------------
NITRO_PRESET=node-server
HOST=0.0.0.0
PORT=8080
NODE_ENV=development
